-- Starts one of the screens round the round (the wallet, quests, sounds, the lobby's boards) by its name here. A
-- problem in one of them is said in the output and must never stop the game itself from running.
local function begin(name: string)
	local ok, problem = pcall(function()
		local module = script:FindFirstChild(name)
		if not module or not module:IsA("ModuleScript") then
			error("it isn't there")
		end
		local loaded = (require :: any)(module)
		loaded.start()
	end)
	if not ok then
		warn(`[{Config.GameName}] {name} didn't start: {problem}`)
	end
end

